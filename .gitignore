# Virtual environments
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Testing & tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment / credentials
.env
.env.*
!.env.example

# Audio inputs and transcription outputs
# Runs write here; results are files on disk and are not versioned.
audio/
out/
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.opus
*.mp4

# Model weights / caches
models/
*.bin
*.pt
*.ckpt
*.safetensors

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp

# Evaluation: reports are committed as the numbers to beat, hypothesis
# transcripts are regenerable output and the corpus is not ours to vendor.
eval/transcripts/
eval/*.local.json
# Scored against the team's own ground truth: the reference text is theirs, so
# only the reports (which hold scores and checksums) may be committed.
eval/custom/transcripts/
eval/custom/*.local.json

# Copy to .env and fill in only what you use. .env is git-ignored; this file is not.
# An exported variable wins over the value here.

# Speaker diarization (faster-whisper with diarization=true). A Hugging Face
# access token with read access, after accepting the model's conditions at
# https://huggingface.co/pyannote/speaker-diarization-community-1
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# The elevenlabs-scribe backend. Create a key at
# https://elevenlabs.io/app/settings/api-keys
# Audio sent to this backend is uploaded to ElevenLabs and billed per audio hour.
ELEVENLABS_API_KEY=
